.DS_Store

# Web masters produced by scripts/transcode-masters.mjs. These get uploaded to
# your host, never committed — GitHub Pages caps the site at 1GB.
dist/

# pluginhost build outputs: the binary, the CLAP and VST3 headers `make`
# fetches, and the test plugins it compiles. All reproducible from source with
# one `make`.
pluginhost/pluginhost
pluginhost/clap/
pluginhost/vst3/
pluginhost/test/*.clap
pluginhost/test/*.vst3
